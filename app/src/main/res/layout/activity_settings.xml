<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenColor">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        style="@style/ScreenAppBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:contentScrim="?attr/screenColor"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="Settings">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Status: is my calendar up to date? -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/stateDot"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/statusHeadline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusSubline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="26dp"
                        android:paddingTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/syncProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:trackCornerRadius="2dp" />

                    <TextView
                        android:id="@+id/coverage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/nextSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textIsSelectable="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/logIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Log in"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/syncNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sync now" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Calendar -->
            <TextView style="@style/SectionHeader" android:text="Calendar" />
            <com.google.android.material.card.MaterialCardView style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/rangeRow" style="@style/Row">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="How far ahead" />
                            <TextView android:id="@+id/rangeValue" style="@style/RowValue" />
                        </LinearLayout>
                        <ImageView style="@style/RowChevron" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider style="@style/RowDivider" />

                    <LinearLayout android:id="@+id/roomRow" style="@style/Row">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="Room in the event name" />
                            <TextView android:id="@+id/roomValue" style="@style/RowValue" />
                            <TextView
                                style="@style/RowSummary"
                                android:text="Lock screens and widgets often show only the name, so this shows the room there too." />
                        </LinearLayout>
                        <ImageView style="@style/RowChevron" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider style="@style/RowDivider" />

                    <LinearLayout android:id="@+id/subjects" style="@style/Row">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="Subjects (beta)" />
                            <TextView
                                style="@style/RowSummary"
                                android:text="Your own name, emoji and color per subject" />
                        </LinearLayout>
                        <ImageView style="@style/RowChevron" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider style="@style/RowDivider" />

                    <Button
                        android:id="@+id/clearCalendar"
                        style="@style/DangerRow"
                        android:text="Clear calendar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Footnote"
                android:text="Lessons go into a separate calendar called &quot;Eduarte rooster&quot;. Clearing removes it; the next sync brings it back." />

            <!-- Background sync and notifications -->
            <TextView style="@style/SectionHeader" android:text="Background sync &amp; notifications" />
            <com.google.android.material.card.MaterialCardView style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/autoSyncRow" style="@style/Row">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="Sync automatically" />
                            <TextView
                                style="@style/RowSummary"
                                android:text="About every 12 hours. When off, tap the app icon to sync." />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/autoSync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:contentDescription="Sync automatically" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider style="@style/RowDivider" />

                    <LinearLayout android:id="@+id/notificationSettings" style="@style/Row">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="Schedule change notifications" />
                            <TextView android:id="@+id/notificationStatus" style="@style/RowValue" />
                            <TextView
                                style="@style/RowSummary"
                                android:text="Change this in Android settings" />
                        </LinearLayout>
                        <ImageView style="@style/RowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account -->
            <TextView style="@style/SectionHeader" android:text="Account" />
            <com.google.android.material.card.MaterialCardView style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/saveLoginRow" style="@style/Row">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="Fill in my email and password" />
                            <TextView
                                style="@style/RowSummary"
                                android:text="Saved encrypted on this phone at your next login, so only the Authenticator is left. Turning it off deletes them." />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/saveLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:contentDescription="Fill in my email and password" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider style="@style/RowDivider" />

                    <LinearLayout android:id="@+id/loginLog" style="@style/Row">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="Login log" />
                            <TextView
                                style="@style/RowSummary"
                                android:text="What happened at recent logins, to find out why it expires. No passwords or codes." />
                        </LinearLayout>
                        <ImageView style="@style/RowChevron" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider style="@style/RowDivider" />

                    <Button
                        android:id="@+id/logOut"
                        style="@style/DangerRow"
                        android:text="Log out / switch account" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Footnote"
                android:text="Logging out removes your Eduarte login and a saved password from this phone. The calendar stays." />

            <!-- About -->
            <TextView style="@style/SectionHeader" android:text="About" />
            <com.google.android.material.card.MaterialCardView style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Row"
                        android:background="@null"
                        android:clickable="false"
                        android:focusable="false">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="Version" />
                            <TextView android:id="@+id/version" style="@style/RowSummary" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/downloadUpdate"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/allVersionsDivider"
                        style="@style/RowDivider"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/allVersions"
                        style="@style/Row"
                        android:visibility="gone">
                        <LinearLayout style="@style/RowText">
                            <TextView style="@style/RowTitle" android:text="All versions" />
                            <TextView
                                style="@style/RowSummary"
                                android:text="Every release, also older ones" />
                        </LinearLayout>
                        <ImageView style="@style/RowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Footnote"
                android:text="Downloads come from the GitHub Releases page. Install over this version to keep your login. For an older version, uninstall first." />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
