<?xml version="1.0" encoding="utf-8"?>
<!-- One subject on the Subjects page: color circle with the emoji, name, and the original name once customized. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/swatch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout style="@style/RowText">

        <TextView
            android:id="@+id/title"
            style="@style/RowTitle"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/original"
            style="@style/RowSummary"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView style="@style/RowChevron" />
</LinearLayout>
