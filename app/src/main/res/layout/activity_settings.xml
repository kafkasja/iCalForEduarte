<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <TextView style="@style/SectionHeader" android:text="Version" />
        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/downloadUpdate"
            style="@style/RowButton"
            android:visibility="gone" />
        <Button
            android:id="@+id/allVersions"
            style="@style/RowButton"
            android:text="All versions"
            android:visibility="gone" />
        <TextView
            style="@style/Hint"
            android:text="Downloads come from the GitHub Releases page. Install over the current version to keep your login. For an older version, uninstall first." />

        <TextView style="@style/SectionHeader" android:text="Status" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/syncNow"
            style="@style/RowButton"
            android:text="Sync now" />

        <TextView style="@style/SectionHeader" android:text="Sync" />
        <Switch
            android:id="@+id/autoSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Automatic sync every 12 hours" />
        <TextView
            style="@style/Hint"
            android:text="When off, the schedule only syncs when you tap the app icon." />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="How far ahead to sync" />
        <RadioGroup
            android:id="@+id/range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/SectionHeader" android:text="Notifications" />
        <TextView
            android:id="@+id/notificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/notificationSettings"
            style="@style/RowButton"
            android:text="Change in Android settings" />

        <TextView style="@style/SectionHeader" android:text="Calendar" />
        <Button
            android:id="@+id/clearCalendar"
            style="@style/RowButton"
            android:text="Clear calendar" />
        <TextView
            style="@style/Hint"
            android:text="Removes everything this app put in your calendar. Sync again to get it back." />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Room in the event name" />
        <RadioGroup
            android:id="@+id/roomInTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            style="@style/Hint"
            android:text="Lock screens and widgets often show only the name and time of an event. With the room in the name you see it there too." />

        <TextView style="@style/SectionHeader" android:text="Account" />
        <Button
            android:id="@+id/logOut"
            style="@style/RowButton"
            android:text="Log out / switch account" />
        <TextView
            style="@style/Hint"
            android:text="Removes your Eduarte login and a saved password from this phone." />
        <Switch
            android:id="@+id/saveLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Fill in my email and password" />
        <TextView
            style="@style/Hint"
            android:text="When you have to log in again, only the Authenticator is left for you. Saved encrypted on this phone the next time you log in, and only sent to the Microsoft login page. Turning this off deletes them." />
        <Button
            android:id="@+id/loginLog"
            style="@style/RowButton"
            android:text="Login log" />
        <TextView
            style="@style/Hint"
            android:text="What happened during the last logins, to find out why the login keeps expiring. No passwords or codes are in it." />

        <TextView style="@style/SectionHeader" android:text="Beta" />
        <Button
            android:id="@+id/subjects"
            style="@style/RowButton"
            android:text="Subjects" />
        <TextView
            style="@style/Hint"
            android:text="Give each subject its own name, emoji and color in your calendar." />
    </LinearLayout>
</ScrollView>
